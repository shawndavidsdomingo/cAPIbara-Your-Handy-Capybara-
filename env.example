# Brevo > SMTP & API > API keys tab (the v3 API key, NOT the SMTP key).
BREVO_API_KEY=

# The single address every email is sent from. It must be on the authenticated
# domain (capibara-shawn-neo.online in Brevo > Senders, domains & dedicated IPs).
SENDER_EMAIL=
SENDER_NAME=

# Optional: a PUBLIC https link to the logo image (PNG or JPG, about 240 px wide).
# Mail apps cannot load files from your computer. Leave empty for a text header.
LOGO_URL=


#TextBee
TEXTBEE_API_KEY=

TEXTBEE_DEVICE_ID=